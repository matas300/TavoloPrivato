<%- include('../../partials/head') %>
<div class="app-wrap">
  <%- include('../../partials/sidebar') %>
  <%- include('../../partials/topbar') %>
  <main class="main-content">
    <div class="main-inner fade-in-up">

      <div class="tabs">
        <a class="tab <%= filtroStato === 'all' ? 'active' : '' %>" href="/cameriere/contratti">Tutti</a>
        <a class="tab <%= filtroStato === 'confermato' ? 'active' : '' %>" href="/cameriere/contratti?stato=confermato">Confermati</a>
        <a class="tab <%= filtroStato === 'completato' ? 'active' : '' %>" href="/cameriere/contratti?stato=completato">Completati</a>
        <a class="tab <%= filtroStato === 'pagato' ? 'active' : '' %>" href="/cameriere/contratti?stato=pagato">Pagati</a>
        <a class="tab" href="/cameriere/contratti-lunghi">Contratti lunghi</a>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Data</th><th>Ristorante</th><th>Tipo</th><th>Compenso</th><th>Stato</th><th>Val.</th><th></th></tr>
          </thead>
          <tbody>
            <% contratti.forEach(c => { const rist = getUser(c.ristoranteId); %>
              <tr>
                <td><%= c.data %></td>
                <td>
                  <div class="flex items-center gap-sm">
                    <div class="avatar avatar-sm avatar-olive"><%= rist.initials %></div>
                    <%= rist.name %>
                  </div>
                </td>
                <td><span class="badge badge-neutral"><%= c.tipo %></span></td>
                <td class="font-semibold">&euro;<%= c.compensoCam %></td>
                <td>
                  <% if (c.stato === 'pagato' || c.stato === 'completato') { %>
                    <span class="badge badge-olive"><%= c.stato === 'pagato' ? 'Pagato' : 'Completato' %></span>
                  <% } else if (c.stato === 'confermato') { %>
                    <span class="badge badge-terracotta">Confermato</span>
                  <% } else { %>
                    <span class="badge badge-neutral"><%= c.stato %></span>
                  <% } %>
                </td>
                <td>
                  <% if (c.valRist !== null) { %>
                    <div class="stars"><%- include('../../partials/stars', { rating: c.valRist }) %></div>
                  <% } else { %>
                    <span class="text-tiny text-muted">&mdash;</span>
                  <% } %>
                </td>
                <td>
                  <a href="/cameriere/contratti/<%= c.id %>" class="btn btn-ghost btn-sm">Dettagli</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    </div>
  </main>
</div>
<%- include('../../partials/foot') %>
