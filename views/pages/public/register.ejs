<%- include('../../partials/head') %>
<%- include('../../partials/pub-nav') %>

<div class="pub-page-wrap">
  <section class="section" style="max-width:500px;margin:0 auto">
    <div class="text-center mb-xl">
      <h1 class="section-title">Registrati</h1>
      <p class="text-muted">Scegli il tipo di account</p>
    </div>

    <% if (prefillScenario) { %>
      <div class="alert-box alert-info mb-xl">
        <i data-lucide="sparkles" style="width:20px;height:20px;flex-shrink:0;color:var(--olive)"></i>
        <div>
          <strong class="text-sm">Scenario importato dal simulatore</strong>
          <p class="text-sm text-muted mt-sm"><%= prefillScenario.summary %></p>
        </div>
      </div>
    <% } %>

    <div class="grid-2 mb-xl">
      <div class="card card-hover" style="cursor:pointer;text-align:center;border:2px solid <%= selectedRole === 'cameriere' ? 'var(--terracotta)' : 'var(--border-light)' %>" id="reg-cam" onclick="document.getElementById('reg-cam').style.borderColor='var(--terracotta)';document.getElementById('reg-rist').style.borderColor='var(--border-light)';document.getElementById('reg-role').value='cameriere'">
        <div class="card-body">
          <i data-lucide="user" style="width:36px;height:36px;color:var(--terracotta);margin-bottom:var(--space-sm)"></i>
          <h3 class="font-display font-semibold" style="font-size:var(--fs-h3)">Cameriere</h3>
          <p class="text-sm text-muted">Cerco lavoro come freelance</p>
        </div>
      </div>
      <div class="card card-hover" style="cursor:pointer;text-align:center;border:2px solid <%= selectedRole === 'ristorante' ? 'var(--olive)' : 'var(--border-light)' %>" id="reg-rist" onclick="document.getElementById('reg-rist').style.borderColor='var(--olive)';document.getElementById('reg-cam').style.borderColor='var(--border-light)';document.getElementById('reg-role').value='ristorante'">
        <div class="card-body">
          <i data-lucide="store" style="width:36px;height:36px;color:var(--olive);margin-bottom:var(--space-sm)"></i>
          <h3 class="font-display font-semibold" style="font-size:var(--fs-h3)">Ristorante</h3>
          <p class="text-sm text-muted">Cerco camerieri freelance</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <form method="POST" action="/register">
          <input type="hidden" name="role" id="reg-role" value="<%= selectedRole %>">
          <div class="form-group">
            <label class="form-label">Nome completo / Nome ristorante</label>
            <input class="form-input" type="text" name="name" placeholder="<%= selectedRole === 'ristorante' ? 'Terrazza Brera' : 'Mario Rossi' %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">Email</label>
            <input class="form-input" type="email" name="email" placeholder="la-tua@email.com" required>
          </div>
          <div class="form-group">
            <label class="form-label">Password</label>
            <input class="form-input" type="password" name="password" placeholder="Minimo 8 caratteri" required>
          </div>
          <label class="form-checkbox mb-lg">
            <input type="checkbox" required> Accetto i <a href="#" style="color:var(--terracotta)">Termini di servizio</a> e la <a href="#" style="color:var(--terracotta)">Privacy Policy</a>
          </label>
          <button type="submit" class="btn btn-primary btn-block btn-lg">Registrati Gratis</button>
        </form>
        <p class="text-center text-sm text-muted mt-lg">Hai gi&agrave; un account? <a href="/login" style="color:var(--terracotta);font-weight:600">Accedi</a></p>
      </div>
    </div>
  </section>
</div>

<%- include('../../partials/foot') %>
