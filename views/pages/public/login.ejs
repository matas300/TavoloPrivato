<%- include('../../partials/head') %>
<%- include('../../partials/pub-nav') %>

<div class="pub-page-wrap">
  <section class="section">
    <div class="auth-grid">
      <div class="auth-side">
        <span class="eyebrow mb-md" style="background:rgba(255,255,255,0.12);color:var(--sand-light)">Marketplace multi-agent</span>
        <h1 class="section-title" style="color:#fff">Accedi e attiva il tuo lato del marketplace</h1>
        <p class="text-muted">Onboarding rapido, chat interna, contratti demo, split payment e guardrail di compliance già incorporati nel prodotto.</p>

        <div class="auth-role-list">
          <div class="auth-role">
            <strong>Worker hospitality</strong>
            <span class="text-sm text-muted">Camerieri, barman e sommelier vedono servizi a prestazione e payout netto previsto.</span>
          </div>
          <div class="auth-role">
            <strong>Ristoranti</strong>
            <span class="text-sm text-muted">Il locale acquista pacchetti di servizio, non ore, con fee piattaforma gia trasparente.</span>
          </div>
          <div class="auth-role">
            <strong>Compliance admin</strong>
            <span class="text-sm text-muted">Alert su concentrazione, continuita pair, ex datore e soglia occasionale.</span>
          </div>
        </div>
      </div>

      <div>
        <div class="text-center mb-xl">
          <h2 class="section-title">Accedi</h2>
          <p class="text-sm text-muted">Google e Apple sono predisposti in UX per il post MVP. Nel demo usi le credenziali qui sotto.</p>
        </div>

        <% if (error) { %>
          <div class="alert-box alert-danger mb-lg">
            <i data-lucide="alert-circle" style="width:20px;height:20px;flex-shrink:0;color:var(--red)"></i>
            <span class="text-sm"><%= error %></span>
          </div>
        <% } %>

        <div class="card mb-lg">
          <div class="card-body">
            <div class="social-grid mb-lg">
              <button type="button" class="social-btn" aria-label="Accedi con Google" onclick="showToast('OAuth Google predisposto nel blueprint, non attivo nel demo')">
                <i data-lucide="chrome" style="width:16px;height:16px"></i> Google
              </button>
              <button type="button" class="social-btn" aria-label="Accedi con Apple" onclick="showToast('OAuth Apple predisposto nel blueprint, non attivo nel demo')">
                <i data-lucide="smartphone" style="width:16px;height:16px"></i> Apple
              </button>
            </div>

            <form method="POST" action="/login">
              <div class="form-group">
                <label class="form-label" for="login-email">Email</label>
                <input class="form-input" id="login-email" type="email" name="email" placeholder="la-tua@email.com" required>
              </div>
              <div class="form-group">
                <label class="form-label" for="login-password">Password</label>
                <input class="form-input" id="login-password" type="password" name="password" placeholder="********" required>
              </div>
              <button type="submit" class="btn btn-primary btn-block btn-lg">Accedi al demo</button>
            </form>
            <p class="text-center text-sm text-muted mt-lg">Non hai un account? <a href="/register" style="color:var(--terracotta);font-weight:600">Registrati</a></p>
          </div>
        </div>

        <div class="card" style="background:var(--bg-secondary);border:1px dashed var(--border-color)">
          <div class="card-body">
            <p class="text-sm font-semibold mb-sm">Credenziali demo</p>
            <div class="detail-list">
              <div class="detail-row">
                <span class="text-sm text-muted">Cameriere</span>
                <strong>marco@demo.it / demo</strong>
              </div>
              <div class="detail-row">
                <span class="text-sm text-muted">Ristorante</span>
                <strong>mario@demo.it / demo</strong>
              </div>
              <div class="detail-row">
                <span class="text-sm text-muted">Admin</span>
                <strong>admin@demo.it / demo</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../../partials/foot') %>
