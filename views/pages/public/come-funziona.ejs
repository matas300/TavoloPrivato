<%- include('../../partials/head') %>
<%- include('../../partials/pub-nav') %>

<div class="pub-page-wrap">
  <section class="section">
    <div class="text-center mb-xl">
      <p class="section-label">Come funziona</p>
      <h1 class="section-title">Semplice, veloce, <em style="color:var(--terracotta);font-family:var(--font-display);font-style:italic">trasparente.</em></h1>
    </div>

    <h2 class="font-display font-semibold mb-lg" style="font-size:var(--fs-h2)">Se sei un cameriere</h2>
    <div class="steps">
      <div class="step card card-body">
        <div class="step-num">1</div>
        <h3>Crea il tuo profilo</h3>
        <p>Registrati gratis, compila il tuo CV: esperienza, qualifiche, disponibilit&agrave; e zona. In 5 minuti sei online.</p>
      </div>
      <div class="step card card-body">
        <div class="step-num">2</div>
        <h3>Ricevi proposte</h3>
        <p>I ristoranti ti trovano e ti propongono turni. Oppure cerca tu nella bacheca. Scegli cosa ti interessa.</p>
      </div>
      <div class="step card card-body">
        <div class="step-num">3</div>
        <h3>Lavora e guadagna</h3>
        <p>Turno di prova, poi contratto. Pagamento rapido dopo ogni turno. Monitori tutto dal tuo wallet.</p>
      </div>
    </div>

    <h2 class="font-display font-semibold mb-lg mt-xl" style="font-size:var(--fs-h2)">Se sei un ristoratore</h2>
    <div class="steps">
      <div class="step card card-body">
        <div class="step-num">1</div>
        <h3>Pubblica il tuo annuncio</h3>
        <p>Data, tipo di servizio, qualifiche richieste e budget. L'annuncio &egrave; visibile in pochi secondi.</p>
      </div>
      <div class="step card card-body">
        <div class="step-num">2</div>
        <h3>Scegli il cameriere</h3>
        <p>Vedi profili, rating e esperienza. Contatta, fai un colloquio, organizza un turno di prova.</p>
      </div>
      <div class="step card card-body">
        <div class="step-num">3</div>
        <h3>Paghi solo il lavoro</h3>
        <p>Niente contributi, niente TFR. Paghi la giornata tramite piattaforma. Fattura automatica.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <p class="section-label">Il percorso completo</p>
    <h2 class="section-title mb-xl">Dal primo contatto al pagamento</h2>
    <div style="max-width:600px">
      <div class="timeline-item">
        <div class="timeline-dot done"><i data-lucide="search" style="width:14px;height:14px;color:var(--olive)"></i></div>
        <div><strong>Ricerca</strong><p class="text-sm text-muted">Il ristorante cerca camerieri o il cameriere cerca annunci</p></div>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot done"><i data-lucide="message-circle" style="width:14px;height:14px;color:var(--olive)"></i></div>
        <div><strong>Richiesta colloquio</strong><p class="text-sm text-muted">Primo contatto tramite messaggi in piattaforma</p></div>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot active"><i data-lucide="video" style="width:14px;height:14px;color:var(--terracotta)"></i></div>
        <div><strong>Colloquio</strong><p class="text-sm text-muted">Video call o incontro di persona</p></div>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot"><i data-lucide="clock" style="width:14px;height:14px"></i></div>
        <div><strong>Turno di prova</strong><p class="text-sm text-muted">Mezza giornata o giornata intera, con valutazione reciproca</p></div>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot"><i data-lucide="file-signature" style="width:14px;height:14px"></i></div>
        <div><strong>Contratto</strong><p class="text-sm text-muted">Generato automaticamente, firma digitale semplice</p></div>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot"><i data-lucide="wallet" style="width:14px;height:14px"></i></div>
        <div><strong>Pagamento</strong><p class="text-sm text-muted">Il ristorante paga la piattaforma, la piattaforma paga il cameriere</p></div>
      </div>
    </div>
  </section>
</div>

<%- include('../../partials/pub-footer') %>
<%- include('../../partials/foot') %>
