<%- include('../../partials/head') %>
<%- include('../../partials/pub-nav') %>

<div class="pub-page-wrap">
  <section class="section text-center">
    <p class="section-label">Commissioni</p>
    <h1 class="section-title">Trasparente. <em style="color:var(--terracotta);font-family:var(--font-display);font-style:italic">Senza sorprese.</em></h1>
    <p class="text-muted mb-xl" style="max-width:560px;margin-left:auto;margin-right:auto">TavoloLibero trattiene una commissione fissa per ogni giornata lavorata. Il cameriere sa esattamente quanto guadagna.</p>

    <div class="grid-3" style="max-width:900px;margin:0 auto;align-items:start">
      <div class="pricing-card">
        <div class="badge badge-neutral mb-md">Servizio singolo</div>
        <div class="pricing-amount">&euro;10</div>
        <div class="text-sm text-muted mb-lg">per pranzo o cena</div>
        <div class="text-sm text-muted" style="line-height:1.8">
          Ristorante paga &euro;80-100<br>
          Cameriere riceve &euro;70-90<br>
          Commissione fissa
        </div>
      </div>
      <div class="pricing-card featured">
        <div class="badge badge-terracotta mb-md">Giornata intera</div>
        <div class="pricing-amount">&euro;20</div>
        <div class="text-sm text-muted mb-lg">per full-day</div>
        <div class="text-sm text-muted" style="line-height:1.8">
          Ristorante paga &euro;140-180<br>
          Cameriere riceve &euro;120-160<br>
          Commissione fissa
        </div>
      </div>
      <div class="pricing-card">
        <div class="badge badge-olive mb-md">Evento speciale</div>
        <div class="pricing-amount">&euro;25</div>
        <div class="text-sm text-muted mb-lg">matrimoni, gala, corporate</div>
        <div class="text-sm text-muted" style="line-height:1.8">
          Ristorante paga &euro;180-250<br>
          Cameriere riceve &euro;155-225<br>
          Commissione fissa
        </div>
      </div>
    </div>
    <p class="text-tiny text-muted mt-xl">Le commissioni sono configurabili dall'admin. I valori mostrati sono indicativi. Nessun costo di registrazione.</p>
  </section>
</div>

