<%- include('../../partials/head') %>
<div class="app-wrap">
  <%- include('../../partials/sidebar') %>
  <%- include('../../partials/topbar') %>
  <main class="main-content">
    <div class="main-inner fade-in-up">

      <div class="hero-panel mb-xl">
        <div class="flex justify-between items-start gap-lg flex-wrap">
          <div style="max-width:820px">
            <span class="eyebrow mb-sm">Legal + billing visibility</span>
            <h1 class="font-display font-semibold" style="font-size:var(--fs-h1);line-height:1.05">Qui vedi davvero tutto quello che abbiamo costruito dietro le quinte.</h1>
            <p class="page-lead mt-md">Questa console espone audit legale, contratti lunghi, milestone, fatture, trigger di billing e controlli predittivi di compliance. L’obiettivo e eliminare zone d’ombra tra backend, documentazione e interfaccia.</p>
          </div>
          <div class="metric-strip">
            <div class="metric-pill">
              <span>Policy runtime</span>
              <strong><%= policyVersion %></strong>
            </div>
            <div class="metric-pill">
              <span>Contratti lunghi</span>
              <strong><%= stats.longContracts %></strong>
            </div>
            <div class="metric-pill">
              <span>Invoice aperte</span>
              <strong><%= stats.openInvoices %></strong>
            </div>
          </div>
        </div>
      </div>

      <div class="grid-4 mb-xl">
        <div class="stat-card">
          <div class="stat-value"><%= stats.longContracts %></div>
          <div class="stat-label">Contratti lunghi esposti</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.plannedMilestones %></div>
          <div class="stat-label">Milestone pianificate</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.processingMilestones %></div>
          <div class="stat-label">Milestone in billing</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.paidInvoices %></div>
          <div class="stat-label">Invoice pagate</div>
        </div>
      </div>

      <div class="grid-2 mb-xl">
        <div class="card">
          <div class="card-body">
            <span class="eyebrow mb-sm">Operazioni</span>
            <h3 class="font-display font-semibold mb-md" style="font-size:var(--fs-h3)">Lancia billing mensile</h3>
            <p class="text-sm text-muted mb-md">Questa azione espone l’operativita del `PaymentAgent`: genera billing per milestone maturate e tenta la cattura su quelle gia scadute.</p>
            <div class="form-row">
              <div class="form-group" style="margin-bottom:0">
                <label class="form-label">Data di esecuzione</label>
                <input id="billing-run-date" class="form-input" type="datetime-local" value="2026-05-31T12:00">
              </div>
              <div class="form-group" style="margin-bottom:0;display:flex;align-items:end">
                <button type="button" class="btn btn-primary w-full" id="billing-run-button">Esegui billing cycle</button>
              </div>
            </div>
            <div id="billing-run-result" class="surface-muted mt-md">
              <p class="text-sm text-muted">Nessuna esecuzione ancora lanciata da questa console.</p>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <span class="eyebrow mb-sm">Operazioni</span>
            <h3 class="font-display font-semibold mb-md" style="font-size:var(--fs-h3)">Test compliance pair</h3>
            <p class="text-sm text-muted mb-md">Questo form espone il `ComplianceAgent` anche fuori dal flusso ristorante, cosi admin puo verificare subito giorni, concentrazione ed ex-datore.</p>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Worker</label>
                <select id="compliance-worker" class="form-input form-select">
                  <% workers.forEach(worker => { %>
                    <option value="<%= worker.id %>"><%= worker.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Ristorante</label>
                <select id="compliance-restaurant" class="form-input form-select">
                  <% restaurants.forEach(restaurant => { %>
                    <option value="<%= restaurant.id %>"><%= restaurant.name %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Proiezione lorda</label>
                <input id="compliance-gross" class="form-input" type="number" value="6000">
              </div>
              <div class="form-group">
                <label class="form-label">Giorni stimati</label>
                <input id="compliance-days" class="form-input" type="number" value="36">
              </div>
            </div>
            <button type="button" class="btn btn-outline" id="compliance-check-button">Esegui check</button>
            <div id="compliance-check-result" class="surface-muted mt-md">
              <p class="text-sm text-muted">Nessun controllo eseguito da questa console.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid-2 mb-xl">
        <div class="card">
          <div class="card-body">
            <span class="eyebrow mb-sm">Documenti</span>
            <h3 class="font-display font-semibold mb-md" style="font-size:var(--fs-h3)">Artifact esposti</h3>
            <div class="sim-action-buttons mb-md">
              <a href="/api/blueprint/legal-audit" class="btn btn-outline btn-sm" target="_blank" rel="noreferrer">Audit markdown</a>
              <a href="/api/blueprint/prisma" class="btn btn-outline btn-sm" target="_blank" rel="noreferrer">Prisma schema</a>
              <a href="/api/blueprint/sql" class="btn btn-outline btn-sm" target="_blank" rel="noreferrer">SQL schema</a>
              <a href="/admin/blueprint" class="btn btn-ghost btn-sm">Architecture view</a>
            </div>
            <div class="code-panel"><%= legalAuditPreview %></div>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <span class="eyebrow mb-sm">Accesso prodotto</span>
            <h3 class="font-display font-semibold mb-md" style="font-size:var(--fs-h3)">Dove lo vede l’utente finale</h3>
            <div class="note-list">
              <div class="surface-muted">
                <strong>Ristorante</strong><br>
                <span class="text-sm text-muted">Voce menu “Contratti Lunghi” con form, check compliance, generazione PDF e milestone.</span>
              </div>
              <div class="surface-muted">
                <strong>Annunci e pagamenti</strong><br>
                <span class="text-sm text-muted">CTA dedicate per portare il ristoratore nel flusso dei contratti estesi.</span>
              </div>
              <div class="surface-muted">
                <strong>Admin</strong><br>
                <span class="text-sm text-muted">Questa pagina espone billing run, audit e check pair che prima erano solo API o codice.</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-xl">
        <div class="card-body">
          <div class="flex justify-between items-start gap-lg flex-wrap mb-lg">
            <div>
              <span class="eyebrow mb-sm">Contratti lunghi</span>
              <h3 class="font-display font-semibold" style="font-size:var(--fs-h3)">Archivio contratti generati</h3>
            </div>
            <a href="/ristorante/contratti-lunghi" class="btn btn-outline btn-sm">Apri vista ristorante</a>
          </div>

          <% if (!longContracts.length) { %>
            <div class="surface-muted">
              <p class="text-sm text-muted">Nessun contratto lungo presente nel seed corrente. La vista resta pronta e gli artifact sono comunque esposti.</p>
            </div>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Worker</th>
                    <th>Ristorante</th>
                    <th>Oggetto</th>
                    <th>Termini</th>
                    <th>Milestone</th>
                    <th>PDF</th>
                  </tr>
                </thead>
                <tbody>
                  <% longContracts.forEach(item => { %>
                    <tr>
                      <td>#<%= item.id %></td>
                      <td><%= item.workerName %></td>
                      <td><%= item.restaurantName %></td>
                      <td><%= item.objectiveSummary %></td>
                      <td><%= item.paymentTerms %></td>
                      <td><%= item.milestoneCount %></td>
                      <td>
                        <% if (item.pdfUrl) { %>
                          <a href="<%= item.pdfUrl %>" target="_blank" rel="noreferrer">apri</a>
                        <% } else { %>
                          <span class="text-tiny text-muted">n/d</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <div class="flex justify-between items-start gap-lg flex-wrap mb-lg">
            <div>
              <span class="eyebrow mb-sm">Invoice</span>
              <h3 class="font-display font-semibold" style="font-size:var(--fs-h3)">Ultime fatture milestone</h3>
            </div>
            <span class="badge badge-neutral">billing visibile</span>
          </div>

          <% if (!invoices.length) { %>
            <div class="surface-muted">
              <p class="text-sm text-muted">Nessuna invoice milestone ancora presente nel seed attuale.</p>
            </div>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Numero</th>
                    <th>Contratto</th>
                    <th>Worker</th>
                    <th>Ristorante</th>
                    <th>Importo</th>
                    <th>Scadenza</th>
                    <th>Stato</th>
                  </tr>
                </thead>
                <tbody>
                  <% invoices.forEach(item => { %>
                    <tr>
                      <td><%= item.number || ('INV-' + item.id) %></td>
                      <td>#<%= item.contractId %></td>
                      <td><%= item.workerName %></td>
                      <td><%= item.restaurantName %></td>
                      <td>EUR <%= item.amountEur.toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                      <td><%= item.dueDate ? new Date(item.dueDate).toLocaleDateString('it-IT') : 'n/d' %></td>
                      <td><span class="badge <%= item.invoiceStatus === 'paid' ? 'badge-olive' : item.invoiceStatus === 'open' || item.invoiceStatus === 'draft' ? 'badge-terracotta' : 'badge-yellow' %>"><%= item.invoiceStatus %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>

<script>
  window.TL_ADMIN_LEGAL_BILLING = {
    defaultBillingAsOf: '2026-05-31T12:00:00.000Z'
  };
</script>
<script src="/js/admin-legal-billing.js"></script>
<%- include('../../partials/foot') %>
