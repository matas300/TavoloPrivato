<%- include('../../partials/head') %>
<div class="app-wrap">
  <%- include('../../partials/sidebar') %>
  <%- include('../../partials/topbar') %>
  <main class="main-content">
    <div class="main-inner fade-in-up">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Timestamp</th><th>Utente</th><th>Azione</th><th>Tipo</th></tr></thead>
          <tbody>
            <% auditLog.forEach(l => { %>
              <tr>
                <td class="text-tiny" style="white-space:nowrap"><%= l.time %></td>
                <td><%= l.user %></td>
                <td class="text-sm"><%= l.action %></td>
                <td><span class="badge badge-neutral"><%= l.tipo %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
<%- include('../../partials/foot') %>
