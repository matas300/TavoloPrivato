<header class="topbar">
  <div class="flex items-center gap-md">
    <button class="menu-toggle" onclick="toggleSidebar()" aria-label="Menu"><i data-lucide="menu" style="width:18px;height:18px"></i></button>
    <span class="topbar-title"><%= title %></span>
  </div>
  <div class="topbar-actions">
    <a href="<%= currentUser.role === 'admin' ? '/admin/alert' : '/' + currentUser.role + '/messaggi' %>" class="btn-icon" style="position:relative" aria-label="Notifiche">
      <i data-lucide="bell" style="width:18px;height:18px"></i>
      <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
        <span class="badge-count" style="position:absolute;top:-4px;right:-4px"><%= unreadCount %></span>
      <% } %>
    </a>
    <a href="/<%= currentUser.role === 'admin' ? 'admin' : currentUser.role %>/dashboard" class="flex items-center gap-sm">
      <div class="avatar avatar-sm"><%= currentUser.initials %></div>
      <span class="text-sm font-semibold mob-hide"><%= currentUser.name.split(' ')[0] %></span>
    </a>
  </div>
</header>
