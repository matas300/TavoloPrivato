<nav class="pub-nav">
  <a class="logo logo-sm" href="/">
    <%- include('logo-svg') %>
    <span class="logo-text">Tavolo<span>Libero</span></span>
  </a>
  <div class="pub-nav-links">
    <a href="/" class="<%= path === '/' ? 'active' : '' %>">Per Camerieri</a>
    <a href="/per-ristoranti" class="<%= path === '/per-ristoranti' ? 'active' : '' %>">Per Ristoranti</a>
    <a href="/come-funziona" class="<%= path === '/come-funziona' ? 'active' : '' %>">Come Funziona</a>
    <a href="/simulatore-guadagno" class="<%= path === '/simulatore-guadagno' || path === '/simulatore-ristoratori' ? 'active' : '' %>">Simulatore</a>
    <a href="/pricing" class="<%= path === '/pricing' ? 'active' : '' %>">Commissioni</a>
    <a href="/faq" class="<%= path === '/faq' ? 'active' : '' %>">FAQ</a>
    <% if (currentUser) { %>
      <a href="/<%= currentUser.role === 'admin' ? 'admin' : currentUser.role %>/dashboard" class="btn btn-sm btn-primary">Dashboard</a>
    <% } else { %>
      <a href="/login" class="btn btn-sm btn-outline">Accedi</a>
      <a href="/register" class="btn btn-sm btn-primary">Registrati</a>
    <% } %>
  </div>
  <button class="btn-icon" onclick="toggleTheme()" aria-label="Cambia tema">
    <i data-lucide="moon" class="theme-icon-light"></i>
    <i data-lucide="sun" class="theme-icon-dark" style="display:none"></i>
  </button>
</nav>
